{
  "name": "fragarach-monorepo",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "stage:npm": "node scripts/stage-platform-binary.mjs",
    "corpus:m:generate": "node scripts/generate-aobane-m-corpus.mjs",
    "corpus:m:check": "node scripts/validate-aobane-m-corpus.mjs",
    "corpus:diverse:generate": "node scripts/generate-enterprise-diverse-corpus.mjs",
    "corpus:diverse:check": "node scripts/validate-enterprise-diverse-corpus.mjs",
    "corpus:longform:generate": "node scripts/generate-enterprise-longform-corpus.mjs",
    "corpus:longform:check": "node scripts/validate-enterprise-longform-corpus.mjs",
    "corpus:dynamic-validity-scale:generate": "node scripts/generate-dynamic-validity-scale-corpus.mjs",
    "corpus:dynamic-validity-scale:check": "node scripts/validate-dynamic-validity-scale-corpus.mjs",
    "corpus:dynamic-validity-practical:generate": "node scripts/generate-dynamic-validity-practical-corpus.mjs",
    "corpus:dynamic-validity-practical:check": "node scripts/validate-dynamic-validity-scale-corpus.mjs --root tests/corpora/aobane-industries-ja-dynamic-validity-practical-variation",
    "corpus:dynamic-validity-practical:chunks": "uv run --with tiktoken --with transformers python tests/benchmarks/rag-comparison/prepare-longform-chunks.py --corpus tests/corpora/aobane-industries-ja-dynamic-validity-practical-variation --output target/benchmarks/dynamic-validity-practical-variation-v2/ruri-512.jsonl --chunk-tokens 512 --overlap-tokens 64 --encoding ruri",
    "corpus:longform:chunks:512": "uv run --with tiktoken python tests/benchmarks/rag-comparison/prepare-longform-chunks.py --output target/benchmarks/longform/chunks-512.jsonl --chunk-tokens 512 --overlap-tokens 64",
    "corpus:longform:chunks:1024": "uv run --with tiktoken python tests/benchmarks/rag-comparison/prepare-longform-chunks.py --output target/benchmarks/longform/chunks-1024.jsonl --chunk-tokens 1024 --overlap-tokens 128",
    "benchmark:longform:raw:512": "node tests/benchmarks/rag-comparison/run-longform-raw-comparison.mjs --chunks target/benchmarks/longform/chunks-512.jsonl --output target/benchmarks/longform/raw-512-purpose --scope purpose",
    "benchmark:longform:raw:1024": "node tests/benchmarks/rag-comparison/run-longform-raw-comparison.mjs --chunks target/benchmarks/longform/chunks-1024.jsonl --output target/benchmarks/longform/raw-1024-purpose --scope purpose",
    "benchmark:diverse:raw": "node tests/benchmarks/rag-comparison/run-enterprise-domain-baseline.mjs",
    "benchmark:diverse:oracle": "node tests/benchmarks/rag-comparison/run-enterprise-domain-oracle.mjs",
    "benchmark:diverse:actual-compile": "node scripts/run-enterprise-actual-compile.mjs",
    "benchmark:diverse:actual-retrieval": "node tests/benchmarks/rag-comparison/run-enterprise-actual-retrieval.mjs",
    "benchmark:raw-tune": "node tests/benchmarks/rag-comparison/run-raw-tuning.mjs",
    "benchmark:hybrid-tune": "node tests/benchmarks/rag-comparison/run-hybrid-tuning.mjs",
    "benchmark:validity-oracle": "cargo run -p fragarach-resolver --example compare_oracle -- --output target/benchmarks/document-validity/oracle-comparison.json",
    "benchmark:validity-gemma": "cargo run -p fragarach-resolver --example compare_profile_extraction -- --provider ollama --model gemma4:latest",
    "benchmark:validity-codex": "cargo run -p fragarach-resolver --example compare_profile_extraction -- --provider codex --model gpt-5.6-luna --effort low",
    "benchmark:validity-e2e-gemma": "cargo run -p fragarach-resolver --example compare_oracle -- --extraction target/benchmarks/document-validity/profile-extraction-ollama-gemma4-latest.json --output target/benchmarks/document-validity/end-to-end-gemma4.json",
    "benchmark:validity-e2e-codex": "cargo run -p fragarach-resolver --example compare_oracle -- --extraction target/benchmarks/document-validity/profile-extraction-codex-gpt-5.6-luna.json --output target/benchmarks/document-validity/end-to-end-codex-luna.json",
    "benchmark:validity-holdout-oracle": "cargo run -p fragarach-resolver --example compare_oracle -- --corpus tests/corpora/aobane-industries-ja-validity-holdout --output target/benchmarks/document-validity/holdout-oracle.json",
    "benchmark:validity-holdout-gemma": "cargo run -p fragarach-resolver --example compare_profile_extraction -- --corpus tests/corpora/aobane-industries-ja-validity-holdout --provider ollama --model gemma4:latest --output target/benchmarks/document-validity/holdout-profile-gemma.json",
    "benchmark:validity-holdout-codex": "cargo run -p fragarach-resolver --example compare_profile_extraction -- --corpus tests/corpora/aobane-industries-ja-validity-holdout --provider codex --model gpt-5.6-luna --effort low --output target/benchmarks/document-validity/holdout-profile-codex.json",
    "benchmark:validity-holdout-e2e-gemma": "cargo run -p fragarach-resolver --example compare_oracle -- --corpus tests/corpora/aobane-industries-ja-validity-holdout --extraction target/benchmarks/document-validity/holdout-profile-gemma.json --output target/benchmarks/document-validity/holdout-e2e-gemma.json",
    "benchmark:validity-holdout-e2e-codex": "cargo run -p fragarach-resolver --example compare_oracle -- --corpus tests/corpora/aobane-industries-ja-validity-holdout --extraction target/benchmarks/document-validity/holdout-profile-codex.json --output target/benchmarks/document-validity/holdout-e2e-codex.json",
    "benchmark:versionqa:prepare": "uv run --with pypdf python tests/benchmarks/rag-comparison/prepare-versionqa.py --versionqa-root target/external/versionrag --output target/benchmarks/versionqa/prepared",
    "benchmark:versionqa:chunks": "uv run --with tiktoken python tests/benchmarks/rag-comparison/prepare-longform-chunks.py --corpus target/benchmarks/versionqa/prepared --output target/benchmarks/versionqa/chunks-512.jsonl --chunk-tokens 512 --overlap-tokens 50",
    "benchmark:versionqa:raw": "node tests/benchmarks/rag-comparison/run-versionqa-raw-retrieval.mjs",
    "benchmark:versionqa:fragrach-retrieval": "node tests/benchmarks/rag-comparison/run-versionqa-fragrach-retrieval.mjs",
    "benchmark:versionqa:answers": "node tests/benchmarks/rag-comparison/run-versionqa-answers.mjs --model gpt-5.6-luna --reasoning-effort low --concurrency 8",
    "benchmark:versionqa:rescore": "node tests/benchmarks/rag-comparison/rescore-versionqa-answers.mjs",
    "benchmark:versionqa:query-packets": "node tests/benchmarks/rag-comparison/run-versionqa-query-packet-retrieval.mjs",
    "benchmark:versionqa:query-answers": "node tests/benchmarks/rag-comparison/run-versionqa-answers.mjs --query-packet-retrieval target/benchmarks/versionqa/query-packet-retrieval-v7/retrieval.jsonl --only-condition fragrach-query-packet-v1 --output target/benchmarks/versionqa/query-packet-answers-v4 --model gpt-5.6-luna --reasoning-effort low --concurrency 8",
    "benchmark:multihop-rag:prepare": "node tests/benchmarks/rag-comparison/prepare-multihop-rag.mjs --output target/benchmarks/multihop-rag/prepared-v2",
    "benchmark:multihop-rag:chunks": "uv run --with tiktoken python tests/benchmarks/rag-comparison/prepare-longform-chunks.py --corpus target/benchmarks/multihop-rag/prepared-v2 --output target/benchmarks/multihop-rag/chunks-512.jsonl --chunk-tokens 512 --overlap-tokens 50",
    "benchmark:multihop-rag:raw": "node tests/benchmarks/rag-comparison/run-multihop-rag-retrieval.mjs --corpus target/benchmarks/multihop-rag/prepared-v2 --output target/benchmarks/multihop-rag/raw-retrieval-v2",
    "benchmark:multihop-rag:obligations": "node tests/benchmarks/rag-comparison/compile-multihop-query-obligations.mjs",
    "benchmark:multihop-rag:holdout-obligations": "node tests/benchmarks/rag-comparison/compile-multihop-query-obligations.mjs --splits holdout --output target/benchmarks/multihop-rag/query-obligations-holdout-v1.jsonl",
    "benchmark:multihop-rag:bridges": "node tests/benchmarks/rag-comparison/compile-multihop-entity-bridges.mjs",
    "benchmark:multihop-rag:packets": "node tests/benchmarks/rag-comparison/run-multihop-rag-packets.mjs",
    "benchmark:multihop-rag:answers": "node tests/benchmarks/rag-comparison/run-multihop-rag-answers.mjs",
    "benchmark:multihop-rag:holdout": "node tests/benchmarks/rag-comparison/run-multihop-rag-holdout.mjs",
    "benchmark:multihop-rag:holdout-answers": "node tests/benchmarks/rag-comparison/run-multihop-rag-holdout-answers.mjs",
    "benchmark:enterprise-rag-bench:prepare": "uv run --with pyarrow python tests/benchmarks/rag-comparison/prepare-enterprise-rag-bench.py --questions target/external/enterprise-rag-bench-metadata/questions.jsonl --documents target/external/enterprise-rag-bench-data-metadata/data/documents/test.parquet --output target/benchmarks/enterprise-rag-bench/prepared-v2",
    "benchmark:enterprise-rag-bench:index": "uv run --with pyarrow --with tantivy python tests/benchmarks/rag-comparison/index-enterprise-rag-bench.py --documents target/external/enterprise-rag-bench-data-metadata/data/documents/test.parquet --output target/benchmarks/enterprise-rag-bench/tantivy-bm25-v1",
    "benchmark:enterprise-rag-bench:bm25": "uv run --with tantivy python tests/benchmarks/rag-comparison/run-enterprise-rag-bench-bm25.py --index target/benchmarks/enterprise-rag-bench/tantivy-bm25-v1 --questions target/benchmarks/enterprise-rag-bench/prepared-v2/questions.jsonl --output target/benchmarks/enterprise-rag-bench/bm25-v1 --candidate-k 50",
    "benchmark:enterprise-rag-bench:ruri": "node tests/benchmarks/rag-comparison/run-enterprise-rag-bench-ruri.mjs",
    "benchmark:enterprise-rag-bench:obligations": "node tests/benchmarks/rag-comparison/compile-enterprise-rag-bench-obligations.mjs",
    "benchmark:enterprise-rag-bench:obligations:merge": "node tests/benchmarks/rag-comparison/merge-enterprise-rag-bench-obligations.mjs",
    "benchmark:enterprise-rag-bench:gold-audit:merge": "node tests/benchmarks/rag-comparison/merge-enterprise-rag-bench-gold-audits.mjs",
    "benchmark:enterprise-rag-bench:dossiers": "uv run --with tantivy python tests/benchmarks/rag-comparison/run-enterprise-rag-bench-dossiers.py --index target/benchmarks/enterprise-rag-bench/tantivy-bm25-v1 --questions target/benchmarks/enterprise-rag-bench/prepared-v3/questions.jsonl --gold-documents target/benchmarks/enterprise-rag-bench/prepared-v3/gold-documents.jsonl --obligations target/benchmarks/enterprise-rag-bench/query-obligations-v1.jsonl --baseline target/benchmarks/enterprise-rag-bench/bm25-v1/retrieval.jsonl --output target/benchmarks/enterprise-rag-bench/query-dossiers-v6",
    "benchmark:enterprise-rag-bench:position-dossiers": "python tests/benchmarks/rag-comparison/compile-enterprise-rag-bench-position-dossiers.py --questions target/benchmarks/enterprise-rag-bench/prepared-v3/questions.jsonl --obligations target/benchmarks/enterprise-rag-bench/query-obligations-v1.jsonl --retrieval target/benchmarks/enterprise-rag-bench/query-dossiers-v2/retrieval.jsonl --output target/benchmarks/enterprise-rag-bench/position-dossiers-v2",
    "benchmark:enterprise-rag-bench:answers:merge": "node tests/benchmarks/rag-comparison/merge-enterprise-rag-bench-answers.mjs",
    "benchmark:enterprise-rag-bench:adaptive-dossiers": "python tests/benchmarks/rag-comparison/compile-enterprise-rag-bench-adaptive-dossiers.py --questions target/benchmarks/enterprise-rag-bench/prepared-v3/questions.jsonl --gold-documents target/benchmarks/enterprise-rag-bench/prepared-v3/gold-documents.jsonl --obligations target/benchmarks/enterprise-rag-bench/query-obligations-v1.jsonl --retrieval target/benchmarks/enterprise-rag-bench/query-dossiers-v6/retrieval.jsonl --output target/benchmarks/enterprise-rag-bench/adaptive-dossiers-v8",
    "benchmark:enterprise-rag-bench:vanilla-dossiers": "python tests/benchmarks/rag-comparison/compile-enterprise-rag-bench-vanilla-dossiers.py --questions target/benchmarks/enterprise-rag-bench/prepared-v3/questions.jsonl --gold-documents target/benchmarks/enterprise-rag-bench/prepared-v3/gold-documents.jsonl --retrieval target/benchmarks/enterprise-rag-bench/query-dossiers-v6/retrieval.jsonl --context-budget 50848.83 --output target/benchmarks/enterprise-rag-bench/vanilla-dossiers-v3",
    "benchmark:dynamic-validity:tune": "node tests/benchmarks/rag-comparison/run-dynamic-validity-tuning.mjs",
    "benchmark:dynamic-validity:answers": "node tests/benchmarks/rag-comparison/run-dynamic-validity-answers.mjs --provider codex-app-server --model gpt-5.6-luna --reasoning-effort low --batch-size 16 --concurrency 8",
    "benchmark:dynamic-validity-scale:tune": "node tests/benchmarks/rag-comparison/run-dynamic-validity-tuning.mjs --corpus tests/corpora/aobane-industries-ja-dynamic-validity-scale --output target/benchmarks/dynamic-validity-scale --profiles ruri",
    "benchmark:dynamic-validity-scale:fcompile": "node scripts/run-dynamic-validity-fcompile.mjs",
    "benchmark:dynamic-validity-scale:fcompile-retrieval": "node tests/benchmarks/rag-comparison/run-dynamic-validity-fcompile-retrieval.mjs",
    "benchmark:dynamic-validity-scale:answers": "node tests/benchmarks/rag-comparison/run-dynamic-validity-answers.mjs --corpus tests/corpora/aobane-industries-ja-dynamic-validity-scale --input target/benchmarks/dynamic-validity-scale --provider codex-app-server --model gpt-5.6-luna --reasoning-effort low --batch-size 16 --concurrency 8",
    "benchmark:dynamic-validity-practical:fcompile": "node scripts/run-dynamic-validity-fcompile.mjs --corpus tests/corpora/aobane-industries-ja-dynamic-validity-practical-variation --output target/benchmarks/dynamic-validity-practical-metadata-build-v1 --provider metadata --model front-matter-v1 --batch-size 64 --llm-concurrency 1 --shards 12",
    "benchmark:dynamic-validity-practical:retrieval": "node tests/benchmarks/rag-comparison/run-dynamic-validity-practical-variation.mjs",
    "benchmark:dynamic-validity-practical:answers": "node tests/benchmarks/rag-comparison/run-dynamic-validity-answers.mjs --corpus tests/corpora/aobane-industries-ja-dynamic-validity-practical-variation --input target/benchmarks/dynamic-validity-practical-variation-v2 --provider codex-app-server --model gpt-5.6-luna --reasoning-effort low --batch-size 8 --concurrency 8 --split practical_holdout --condition Raw-BM25,raw-bm25-t1.jsonl,T1 --condition Raw-Ruri-Dense,raw-ruri-dense-t1.jsonl,T1 --condition Raw-Fixed-Hybrid,raw-fixed-hybrid-t1.jsonl,T1 --condition Fragrach-Ruri-Packet,fragrach-ruri-packet-t1.jsonl,T1 --condition Fragrach-Fixed-Hybrid-Packet,fragrach-fixed-hybrid-packet-t1.jsonl,T1",
    "test": "node --test tests/benchmarks/rag-comparison/*.test.mjs packages/npm/fragarach/test/*.test.mjs scripts/*.test.mjs"
  },
  "description": "Fragrachは、資料群と利用目的から、RAGへ投入する前の知識をコンパイルするツールです。検索APIやチャットUIは提供せず、原本へ遡れるEvidence、Claim、競合、検索仕様、回答仕様を目的別のKnowledge Buildとして生成します。",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
